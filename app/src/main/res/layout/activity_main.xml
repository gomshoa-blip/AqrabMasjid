<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Language switch -->
        <Button
            android:id="@+id/btnLang"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginBottom="10dp"
            android:minHeight="0dp"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:text="🌐 English"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Top card: next prayer -->
        <LinearLayout
            android:id="@+id/cardNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_green"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="26dp"
            android:paddingBottom="26dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <!-- First row: two framed boxes.
                 Box 1: day + current time.  Box 2: Hijri date + Gregorian date. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:background="@drawable/bg_date_box"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvWeekday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:textColor="@color/gold"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_date_box"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvHijri"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGregorian"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="#DDEFE7"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- One row: framed label "الصلاة القادمة" + prayer name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_label_pill"
                    android:paddingLeft="12dp"
                    android:paddingTop="5dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="5dp"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textColor="#FFFFFF"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- "يؤذن بعد" next to the time left -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLeftLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvNextLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvIqamaLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDriving"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="54dp"
            android:background="@drawable/bg_btn_green"
            android:stateListAnimator="@null"
            android:text="🚗  وضع القيادة"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="54dp"
            android:background="@drawable/bg_btn_gold"
            android:stateListAnimator="@null"
            android:text="خذني لأقرب مسجد"
            android:textAllCaps="false"
            android:textColor="#1F2A24"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="54dp"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:text="حدّث موقعي"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="16sp" />

        <!-- Prayer times table -->
        <LinearLayout
            android:id="@+id/layoutTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Nearest mosques -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:id="@+id/tvMosquesHeader"
            android:text="أقرب المساجد"
            android:textColor="@color/title_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutMosques"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Alerts -->
        <Switch
            android:id="@+id/switchAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="تنبيه عند الأذان، وبعده بـ 10 دقائق للإقامة"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnExact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="54dp"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:text="اسمح بالتنبيه في الوقت الدقيق"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnIqama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="54dp"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:text="وقت الإقامة لكل صلاة"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="16sp" />

        <!-- Share / add / donate -->
        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="54dp"
            android:background="@drawable/bg_btn_green"
            android:stateListAnimator="@null"
            android:text="شارك التطبيق - الدال على الخير كفاعله"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAddMosque"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="54dp"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:text="➕ أضف مسجداً"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnDonate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="54dp"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:text="تبرع عبر منصة إحسان"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
