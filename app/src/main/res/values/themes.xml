<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Day theme. Night theme is in values-night/themes.xml -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/green</item>
        <item name="android:colorPrimaryDark">@color/green_dark</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:colorControlActivated">@color/green</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/tajawal</item>
        <item name="android:alertDialogTheme">@style/AqrabDialog</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- Dark icons (time, battery) on the light top bar -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Urdu and Bengali: the phone's own font (our Arabic font has no Urdu/Bengali letters) -->
    <style name="AppTheme.SystemFont">
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <!-- All app dialogs: rounded card, gold frame, bold green buttons -->
    <style name="AqrabDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/title_text</item>
        <item name="android:textColorPrimary">@color/title_text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/tajawal</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AqrabDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AqrabDialogButton.Soft</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/AqrabDialogButton.Soft</item>
    </style>
    <style name="AqrabDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/title_text</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="AqrabDialogButton.Soft">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
