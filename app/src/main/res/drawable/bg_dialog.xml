<?xml version="1.0" encoding="utf-8"?>
<!-- App dialogs: rounded card with a thin gold frame (same look as the app cards) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="18dp" android:insetRight="18dp" android:insetTop="18dp" android:insetBottom="18dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/surface" />
        <stroke android:width="2dp" android:color="@color/gold" />
        <corners android:radius="26dp" />
        <padding android:left="6dp" android:right="6dp" android:top="10dp" android:bottom="6dp" />
    </shape>
</inset>
